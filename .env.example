# Local development only. Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PORT=3000
AUTH_MODE=test-key
TEST_API_KEY=
STORAGE=memory
# For persistent local history, use postgres and supply DATABASE_URL.
DATABASE_URL=
DATABASE_SSL=false
MODEL_TRANSPORT=direct
GEMMA_CHAT_URL=http://127.0.0.1:8088/v1/chat/completions
GEMMA_MODEL=voice-lab-gemma4
BODHAN_WS_URL=ws://127.0.0.1:8086/v1/audio/transcriptions/realtime
PARLER_SPEECH_URL=http://127.0.0.1:8084/v1/audio/speech
GEMMA_API_KEY=
BODHAN_API_KEY=
PARLER_API_KEY=
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_MS=90000
VOICE_SESSION_SECONDS=600
# Only needed when using Supabase authentication:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated exact HTTPS origins for an additional web client; same origin works automatically.
ALLOWED_ORIGINS=
# Only needed for worker transport:
MODEL_WORKER_TOKEN=
